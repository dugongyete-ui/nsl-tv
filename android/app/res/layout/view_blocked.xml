<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_boot" android:gravity="center" android:orientation="vertical" android:padding="32dp">
    <ImageView android:layout_width="92dp" android:layout_height="92dp"
        android:alpha="0.85" android:src="@mipmap/ic_launcher" android:contentDescription="@string/app_name" />
    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_marginTop="18dp"
        android:src="@drawable/ic_warning" android:contentDescription="Gagal terhubung" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="Koneksi Bermasalah"
        android:textColor="@color/live" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/blockedMsg" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:gravity="center" android:lineSpacingExtra="3dp"
        android:textColor="@color/text_mid" android:textSize="13sp" />
    <Button android:id="@+id/btnRetryBlocked" android:layout_width="wrap_content" android:layout_height="46dp"
        android:layout_marginTop="22dp" android:background="@drawable/btn_ghost" android:minWidth="160dp"
        android:text="Coba Lagi" android:textAllCaps="false" android:textColor="@color/text_hi"
        android:textSize="14sp" android:textStyle="bold" android:stateListAnimator="@null" />
</LinearLayout>
