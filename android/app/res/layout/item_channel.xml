<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/card">
    <FrameLayout android:layout_width="match_parent" android:layout_height="88dp">
        <ImageView android:id="@+id/chLogo" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/logo_bg" android:scaleType="fitCenter"
            android:padding="14dp" android:contentDescription="@string/app_name" />
        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/scrim_channel" android:alpha="0.5" />
        <TextView android:id="@+id/chLive" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="start|top" android:layout_margin="6dp" android:background="@drawable/badge_live"
            android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="1.5dp" android:paddingBottom="1.5dp"
            android:text="LIVE" android:textColor="#FFFFFFFF" android:textSize="8sp" android:textStyle="bold" android:visibility="gone" />
        <ImageView android:id="@+id/chFav" android:layout_width="30dp" android:layout_height="30dp"
            android:layout_gravity="end|top" android:layout_margin="4dp" android:padding="6dp"
            android:src="@drawable/ic_heart_o" android:contentDescription="@string/tab_fav" />
    </FrameLayout>
    <TextView android:id="@+id/chName" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="7dp"
        android:textColor="@color/text_hi" android:textSize="12sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/chGroup" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="1dp" android:paddingBottom="9dp"
        android:textColor="@color/text_lo" android:textSize="9.5sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
